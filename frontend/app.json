{
  "expo": {
    "name": "OKPA",
    "slug": "okpa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "okpa",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.materialnabobra.okpa"
    },
    "android": {
      "package": "com.materialnabobra.okpa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "TUTAJ_WPISZ_SWOJE_PROJECT_ID"
      },
      "router": {
        "origin": false
      }
    }
  }
}
